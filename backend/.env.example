# Configuração da API (prefixo HUBSURG_). Copie para .env e ajuste.
HUBSURG_APP_NAME=HubSurg API
HUBSURG_ENVIRONMENT=dev
HUBSURG_VERSION=0.1.0

# Segurança — DEFINA um segredo forte em produção (ex.: openssl rand -hex 32).
HUBSURG_JWT_SECRET=dev-insecure-change-me
HUBSURG_JWT_TTL_SECONDS=3600

# Rate limiting (janela fixa por IP).
HUBSURG_RATE_LIMIT_REQUESTS=100
HUBSURG_RATE_LIMIT_WINDOW_SECONDS=60
